# Flask Secret Key for signing session cookies
SECRET_KEY=your-secure-random-secret-key-here

# Supabase PostgreSQL Connection String (Use Session Pooler string)
# Format: postgresql://[user]:[password]@[host]:[port]/[database]
# Example: postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
